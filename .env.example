# Copy to .env for LOCAL testing only. Never commit a real .env.
# In production these live in the Vercel dashboard (Project Settings >
# Environment Variables), never in the repo.
#
# Bot token from @BotFather. Required everywhere. Paste the whole token
# (form 123456789:AAH...); never commit the real value.
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_FROM_BOTFATHER
#
# State backend: "file" for local testing, "kv" on Vercel.
STATE_BACKEND=file
# STATE_PATH=./state.json
#
# Vercel KV (Upstash Redis) — only when STATE_BACKEND=kv. Vercel injects
# these automatically when you create a KV store from the dashboard and
# link it to the project; paste them here only for local KV testing.
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KV_STATE_KEY=state
#
# Shared secret for the cron endpoints and /api/post-news. Vercel
# auto-generates CRON_SECRET once a cron is configured; set your own
# value in the dashboard if you want to know it (needed by the VM
# research cron that calls /api/post-news).
CRON_SECRET=choose-a-long-random-secret
#
# Optional: extra webhook hardening. If set, pass the same value as
# secret_token in the setWebhook call; Telegram then sends it back as the
# X-Telegram-Bot-Api-Secret-Token header on every update.
TELEGRAM_WEBHOOK_SECRET=
